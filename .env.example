# Supabase est optionnel : sans ces variables, l'app reste en localStorage.
# Ajoute ces variables dans Vercel + dans un fichier local .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CalSnap — reconnaissance photo. Clé SERVEUR uniquement (jamais NEXT_PUBLIC_).
# Mets AU MOINS une des deux clés ci-dessous. Si les deux sont présentes,
# Gemini (gratuit) est utilisé en priorité.
#
# Option GRATUITE (recommandée) : Google Gemini.
#   Crée une clé sur https://aistudio.google.com/app/apikey (gratuit).
#   Les limites de l'offre gratuite sont indiquées sur aistudio.google.com.
#   Modèles essayés dans l'ordre : GEMINI_MODEL (si renseigné), gemini-3.6-flash,
#   gemini-flash-latest, gemini-3.5-flash, gemini-2.5-flash. Un modèle retiré (404)
#   est sauté automatiquement.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash   # optionnel, pour imposer un modèle

# Option PAYANTE : Anthropic Claude (https://console.anthropic.com).
# Modèles essayés dans l'ordre : ANTHROPIC_MODEL, claude-sonnet-5-5, claude-haiku-5-5.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5   # optionnel
